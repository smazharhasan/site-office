{
  "expo": {
    "name": "Buildiary",
    "slug": "buildiary",
    "scheme": "buildiary",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/buildiary-icon.png",
    "splash": {
      "image": "./assets/buildiary-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A5F"
    },
    "android": {
      "package": "app.buildiary",
      "versionCode": 10100,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/buildiary-adaptive.png",
        "backgroundColor": "#1E3A5F"
      }
    },
    "ios": {
      "bundleIdentifier": "app.buildiary",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "The camera takes photos of materials, bills, site cards and progress on site.",
        "NSLocationWhenInUseUsageDescription": "Your location is stamped on site photos and attendance to show they were taken on site.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "The camera takes photos of materials, bills, site cards and progress on site. Photos are taken live; the gallery is never used.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is stamped on site photos and attendance to show they were taken on site."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "baseDomain": "buildiary.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
