   "fieldtype": "Section Break",
   "label": "Addresses"
  },
  {
   "fieldname": "base_domain",
   "fieldtype": "Data",
   "label": "Customer workspaces end with",
   "reqd": 1,
   "description": "e.g. buildiary.app — a customer named alnoor gets alnoor.buildiary.app"
  },
  {
   "fieldname": "control_host",
   "fieldtype": "Data",
   "label": "This console's address",
   "description": "e.g. my.buildiary.app (sign-up page and this console)"
  },
  {
   "fieldname": "website_url",
   "fieldtype": "Data",
   "label": "Website",
   "description": "e.g. https://buildiary.app"
  },
  {
   "fieldname": "col_d",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "support_email",
   "fieldtype": "Data",
   "label": "Support email",
   "options": "Email"
  },
  {
   "fieldname": "support_whatsapp",
   "fieldtype": "Data",
   "label": "Support WhatsApp number",
   "description": "With country code, e.g. 923001234567"
  },
  {
   "fieldname": "admin_emails",
   "fieldtype": "Small Text",
   "label": "Tell these people about sign-ups and payments",
   "description": "One email per line"
  },
  {
   "fieldname": "email_section",
   "fieldtype": "Section Break",
   "label": "Outgoing email",
   "description": "Every email from Buildiary goes out through here: sign-up codes, the welcome letter, trial and payment emails, and the workspaces' own emails (password resets, invitations). With Google Workspace, let this server send through Google's SMTP relay (Google Admin → Apps → Google Workspace → Gmail → Routing → SMTP relay service), then press Email → Send test email."
  },
  {
   "fieldname": "mail_enabled",
   "fieldtype": "Check",
   "label": "Send emails",
   "default": "1"
  },
  {
   "fieldname": "mail_from",
   "fieldtype": "Data",
   "options": "Email",
   "label": "Send from",
   "default": "buildiary@smhglobal.com.pk",
   "description": "Customers see this address, and their replies (with payment receipts) come back to it."
  },
  {
   "fieldname": "mail_sender_name",
   "fieldtype": "Data",
   "label": "Sender name",
   "default": "Buildiary"
  },
  {
   "fieldname": "letter_name",
   "fieldtype": "Data",
   "label": "Welcome letter signed by",
   "default": "Syed Mazhar Hasan"
  },
  {
   "fieldname": "letter_title",
   "fieldtype": "Data",
   "label": "Their title",
   "default": "Managing Director"
  },
  {
   "fieldname": "col_e",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "mail_server",
   "fieldtype": "Data",
   "label": "Mail server",
   "default": "smtp-relay.gmail.com",
   "description": "smtp-relay.gmail.com (Google's relay, no password), or smtp.gmail.com with a sign-in email and an app password."
  },
  {
   "fieldname": "mail_port",
   "fieldtype": "Int",
   "label": "Port",
   "default": "587"
  },
  {
   "fieldname": "mail_use_tls",
   "fieldtype": "Check",
   "label": "Encrypted connection (TLS)",
   "default": "1"
  },
  {
   "fieldname": "mail_login",
   "fieldtype": "Data",
   "label": "Sign-in email (only with an app password)",
   "description": "Leave empty when Google's relay accepts mail from this server's address."
  },
  {
   "fieldname": "mail_password",
   "fieldtype": "Password",
   "label": "App password",
   "depends_on": "mail_login"
  },
  {
   "fieldname": "trial_section",
   "fieldtype": "Section Break",
   "label": "Sign-ups and trial"
  },
  {
   "fieldname": "signups_open",
   "fieldtype": "Check",
   "label": "Accept new sign-ups",
   "default": "1"
  },
  {
   "fieldname": "require_email_verification",
   "fieldtype": "Check",
   "label": "New customers confirm their email with a code",
   "default": "0",
   "description": "Switch on once outgoing email works (Send test email)."
  },
  {
   "fieldname": "trial_days",
   "fieldtype": "Int",
   "label": "Free trial (days)",
   "default": "7",
   "description": "New customers use every feature free for this many days."
  },
  {
   "fieldname": "grace_days",
   "fieldtype": "Int",
   "label": "Days to pay after the trial or plan ends",
   "default": "3"
  },
  {
   "fieldname": "col_t",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "pool_size",
   "fieldtype": "Int",
   "label": "Workspaces kept ready for new customers",
   "default": "1",
   "description": "Each ready workspace makes sign-up take about a minute instead of five."
  },
  {
   "fieldname": "reserved_names",
   "fieldtype": "Small Text",
   "label": "Names customers can't take",
   "default": "www\nmy\napp\napi\nadmin\nconsole\nmail\nsmtp\nftp\nhelp\nsupport\ndocs\nstatus\nblog\nshop\ndemo\ntest\nstaging\nbuildiary\nsmh\nsmhglobal\nbilling\npay\nsecure\nlogin\naccount\naccounts\ncdn\nstatic\nassets\nfiles\nns1\nns2\noffice"
  },
  {
   "fieldname": "money_section",
   "fieldtype": "Section Break",
   "label": "Prices in local money",
   "description": "Customers in Pakistan, Saudi Arabia, the UAE and Qatar see prices in their own money (converted from the plans' USD prices, unless a plan has a fixed local price). Everyone else sees USD."
  },
  {
   "fieldname": "usd_to_pkr",
   "fieldtype": "Float",
   "label": "1 USD in PKR",
   "default": "280"
  },
  {
   "fieldname": "round_pkr",
   "fieldtype": "Int",
   "label": "Round PKR prices to",
   "default": "100"
  },
  {
   "fieldname": "col_m",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "usd_to_sar",
   "fieldtype": "Float",
   "label": "1 USD in SAR",
   "default": "3.75"
  },
  {
   "fieldname": "round_sar",
   "fieldtype": "Int",
   "label": "Round SAR prices to",
   "default": "5"
  },
  {
   "fieldname": "usd_to_aed",
   "fieldtype": "Float",
   "label": "1 USD in AED",
   "default": "3.6725"
  },
  {
   "fieldname": "round_aed",
   "fieldtype": "Int",
   "label": "Round AED prices to",
   "default": "5"
  },
  {
   "fieldname": "usd_to_qar",
   "fieldtype": "Float",
   "label": "1 USD in QAR",
   "default": "3.64"
  },
  {
   "fieldname": "round_qar",
   "fieldtype": "Int",
   "label": "Round QAR prices to",
   "default": "5"
  },
  {
   "fieldname": "bank_section",
   "fieldtype": "Section Break",
   "label": "Where customers pay",
   "description": "Customers see only the accounts for their country: Pakistan accounts for Pakistan, UAE accounts for the UAE, and the Saudi accounts for Saudi Arabia and every other country."
  },
  {
   "fieldname": "bank_accounts",
   "fieldtype": "Table",
   "label": "Bank accounts",
   "options": "Buildiary Bank Account"
  },
  {
   "fieldname": "ai_section",
   "fieldtype": "Section Break",
   "label": "AI for customers",
   "description": "With a key here, every workspace can read bills, check photos and answer questions without its own key. The workspace's own key, if it adds one, is used instead."
  },
  {
   "fieldname": "ai_provider",
   "fieldtype": "Select",
   "label": "AI provider",
   "options": "Off\nGemini\nClaude",
   "default": "Off"
  },
  {
   "fieldname": "ai_api_key",
   "fieldtype": "Password",
   "label": "API key",
   "depends_on": "eval:doc.ai_provider!='Off'"
  },
