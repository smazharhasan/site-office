 "html": "<style>\n.mm-card{width:86mm;height:54mm;border:1px solid #0f6f5c;border-radius:3mm;padding:3mm;box-sizing:border-box;position:relative;font-family:inherit;overflow:hidden;margin:0 auto}\n.mm-card .hd{background:#0f6f5c;color:#fff;margin:-3mm -3mm 2mm;padding:1.5mm 3mm;font-size:9pt;font-weight:700;display:flex;justify-content:space-between}\n.mm-card .ph{position:absolute;left:3mm;top:10mm;width:22mm;height:27mm;object-fit:cover;border:1px solid #ccc;border-radius:1mm}\n.mm-card .info{position:absolute;left:28mm;top:10mm;right:24mm;font-size:8pt;line-height:1.35}\n.mm-card .info b{font-size:10pt;display:block;margin-bottom:1mm}\n.mm-card .qr{position:absolute;right:3mm;top:12mm;width:20mm;height:20mm}\n.mm-card .no{position:absolute;right:3mm;top:33mm;width:20mm;text-align:center;font-size:7.5pt;font-weight:700}\n.mm-card .ft{position:absolute;left:3mm;right:3mm;bottom:2mm;font-size:6.5pt;color:#555;border-top:1px solid #ddd;padding-top:1mm}\n</style>\n{% set pid = frappe.db.get_single_value(\"Buildiary Settings\", \"default_project\") %}{% set project = pid and frappe.db.get_value(\"Project\", pid, \"project_name\") %}\n<div class=\"mm-card\">\n <div class=\"hd\"><span>{{ project or _(\"Site\") }}</span><span>{{ _(\"Site card\") }}</span></div>\n {% if doc.photo %}<img class=\"ph\" src=\"{{ doc.photo }}\">{% else %}<div class=\"ph\"></div>{% endif %}\n <div class=\"info\">\n  <b>{{ doc.full_name }}</b>{% if doc.full_name_ur %}<span style=\"font-family:'Noto Nastaliq Urdu',serif;font-size:9pt;display:block;direction:rtl;text-align:left;line-height:1.9\">{{ doc.full_name_ur }}</span>{% endif %}\n  {% if doc.father_name %}{{ _(\"Father's name\") }}: {{ doc.father_name }}<br>{% endif %}\n  {{ _(doc.worker_type) }}{% if doc.trade %} · {{ _(doc.trade) }}{% endif %}<br>\n  {% if doc.contractor %}{{ doc.contractor }}<br>{% endif %}\n  {% if doc.cnic %}{{ _(\"CNIC\") }}: {{ doc.cnic }}{% endif %}\n </div>\n <img class=\"qr\" src=\"{{ qr_code(card_code(doc.name)) }}\">\n <div class=\"no\">{{ doc.name }}</div>\n <div class=\"ft\">{{ _(\"Show this card at the gate and when marking attendance. If found, please return to the site office.\") }}{% set cv = frappe.db.get_value(\"Site Card\", {\"person\": doc.name}, \"version\") %}{% if cv and cv > 1 %} · {{ _(\"Card {0}\").format(cv) }}{% endif %}</div>\n</div>",
 "line_breaks": 0,
